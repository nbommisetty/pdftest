import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

@RestController
@RequestMapping("/api/debug/egress")
// @Profile({"dev", "test"}) // Optional: uncomment to prevent this bean from loading in actual PROD
public class EgressTestController {

    private final ExternalIntegrationService integrationService;

    public EgressTestController(ExternalIntegrationService integrationService) {
        this.integrationService = integrationService;
    }

    @GetMapping("/test")
    public ResponseEntity<?> triggerEgressTest() {
        try {
            ResponseEntity<String> response = integrationService.testEgressConnection();
            
            // Return exactly what the external API returned
            return ResponseEntity
                    .status(response.getStatusCode())
                    .body("SUCCESS! Status: " + response.getStatusCode() + "\nBody: " + response.getBody());
                    
        } catch (Exception e) {
            // Catch routing, timeout, or proxy auth errors and display them
            return ResponseEntity
                    .status(HttpStatus.INTERNAL_SERVER_ERROR)
                    .body("FAILED to connect via Egress Proxy.\nError: " + e.getMessage());
        }
    }
}
