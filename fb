import org.springframework.beans.factory.annotation.Qualifier;
import org.springframework.stereotype.Service;
import org.springframework.web.client.RestTemplate;

@Service
public class EgressProxyService {

    private final RestTemplate restTemplate;

    // Inject the specific proxy-configured bean
    public EgressProxyService(@Qualifier("egressRestTemplate") RestTemplate restTemplate) {
        this.restTemplate = restTemplate;
    }

    public void callExternalApi() {
        String targetUrl = "https://myapps.com/api/data";
        
        // This request will securely tunnel through the egress proxy
        String response = restTemplate.getForObject(targetUrl, String.class);
        System.out.println(response);
    }
}
