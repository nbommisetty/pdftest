    classDef velocity fill:#e6ffe6,stroke:#009933,stroke-width:2px,color:#000;
    classDef mosaic fill:#e6f2ff,stroke:#0066cc,stroke-width:2px,color:#000;
    classDef data fill:#fff2e6,stroke:#cc6600,stroke-width:2px,color:#000;
    
    class V_App,V_Topic,V_ACL velocity;
    class M_App,M_Topic,M_ACL mosaic;
