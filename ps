node -e '
const url = process.argv[1];
const adapter = url.startsWith("https") ? require("https") : require("http");
const req = adapter.get(url, (res) => {
  console.log(`\nSTATUS: ${res.statusCode}`);
  console.log("HEADERS:");
  console.log(res.headers);
  res.resume(); 
});
req.on("error", (e) => console.error(`Error: ${e.message}`));
' "YOUR_URL_HERE"
