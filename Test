   // NEW: Method for bulk update of field configurations for a form
    @Override
    @Transactional
    public List<TenantApplicationFieldConfig> updateFieldConfigsForForm(
            Long tenantId, Long applicationId, Long formId, List<TenantApplicationFieldConfigUpdateRequest> requests) {

        // 1. Validate existence of tenant, application, and form
        tenantRepository.findById(tenantId)
                .orElseThrow(() -> new ResourceNotFoundException("Tenant not found with ID: " + tenantId));
        applicationRepository.findById(applicationId)
                .orElseThrow(() -> new ResourceNotFoundException("Application not found with ID: " + applicationId));
        Form form = formRepository.findById(formId) // Get the form to validate its existence
                .orElseThrow(() -> new ResourceNotFoundException("Form not found with ID: " + formId));


        // 2. Get all fields that belong to this specific form
        List<Field> fieldsInThisForm = fieldRepository.findByFormId(formId);
        Set<Long> fieldIdsInThisForm = fieldsInThisForm.stream()
                                                    .map(Field::getFieldId)
                                                    .collect(Collectors.toSet());

        // 3. Fetch all existing field configurations for this tenant and application
        List<TenantApplicationFieldConfig> existingConfigsForTenantApp =
                configRepository.findByTenantIdAndApplicationId(tenantId, applicationId);

        // Map existing configs by fieldId for efficient lookup
        Map<Long, TenantApplicationFieldConfig> existingConfigMap = existingConfigsForTenantApp.stream()
                .collect(Collectors.toMap(TenantApplicationFieldConfig::getFieldId, Function.identity()));

        Set<Long> processedFieldIds = new HashSet<>();
        List<TenantApplicationFieldConfig> updatedConfigs = new java.util.ArrayList<>();

        // 4. Process incoming requests (create/update)
        for (TenantApplicationFieldConfigUpdateRequest request : requests) {
            Long fieldId = request.getFieldId(); // Assuming fieldId is part of the update request DTO

            // Validate that the field in the request actually belongs to the specified form
            if (!fieldIdsInThisForm.contains(fieldId)) {
                throw new BadRequestException("Field ID " + fieldId + " does not belong to Form ID " + formId + " and cannot be configured via this endpoint.");
            }

            TenantApplicationFieldConfig config = existingConfigMap.get(fieldId);
            boolean isNew = (config == null);

            if (isNew) {
                config = new TenantApplicationFieldConfig();
                config.setTenantId(tenantId);
                config.setApplicationId(applicationId);
                config.setFieldId(fieldId);
                config.setCreatedBy("system_bulk_create");
            }

            config.setIsEnabled(request.getIsEnabled());
            config.setCustomLabel(request.getCustomLabel());
            config.setCustomValidationRules(request.getCustomValidationRules());
            config.setUpdatedBy("system_bulk_update");

            updatedConfigs.add(configRepository.save(config));
            processedFieldIds.add(fieldId);
        }

        // 5. Delete configurations for fields that existed but are not in the current request
        //    AND belong to the current form.
        List<TenantApplicationFieldConfig> configsToDelete = existingConfigsForTenantApp.stream()
                .filter(existingConfig ->
                        fieldIdsInThisForm.contains(existingConfig.getFieldId()) && // Only consider fields from this form
                        !processedFieldIds.contains(existingConfig.getFieldId()))
                .collect(Collectors.toList());

        configRepository.deleteAll(configsToDelete);

        return updatedConfigs;
    }
