workspace "Customer Profile Verification" "Logical diagram for the Customer Profile Verification process within the Bank." {

    !identifiers hierarchical

    model {

    // Persons
    client = person "Customer" "Bank customer"

    // External Software Systems
    okta = softwareSystem "Okta Identity Platform" "External Identity and Access Management (IAM) service for authentication."
    twilio = softwareSystem "Twilio" "External service for OTP delivery via SMS and Voice." {
        tags "External"
    }
    
    // Vendor-managed containers
    core_banking = softwareSystem "Core Banking System" "Manages core customer and account data (Vendor Managed)." "Mainframe/Legacy System" {
        tags "Vendor"
    }
    codeconnect_gateway = softwareSystem "CodeConnect API Gateway" "Vendor-provided API gateway for core banking services." "API Gateway" {
        tags "Vendor"
    }
    
    // Bank's Applications (Vendor managed Software Systems)
    online_banking = softwareSystem "Online Banking Application" "Web application for customer banking services (Q2/FIS)." {
        tags "Vendor"
    }
    mobile_banking = softwareSystem "Mobile Banking Application" "Native mobile application for customer banking services (Q2/FIS)." {
        tags "Vendor"
    }

    // 2. Define the main Bank's Systems software system and nest its internal containers directly
    bank_systems = softwareSystem "Bank's Systems" "All systems within the Bank's enterprise." {

        // Bank-managed containers
        bank_api_gateway = container "Bank API Gateway" "Routes and secures API calls to internal bank services (Bank Managed)." "API Gateway" {
            tags "Bank"
        }
        kyc_ui = container "Customer Profile KYC UI" "Bank-built web component for customer data verification (Bank Managed)." "Web Application" {
            tags "Bank"
        }
        customer_profile_service = container "Customer Profile Service" "Provides customer demographic, contact, and employment information (Bank Managed)." "Microservice" {
            tags "Bank"
        }
        alerts_service = container "Alerts Service" "Sends notifications to customers upon successful updates." "Microservice" {
            tags "Bank"
        }
        dih_database = container "DIH Database" "Logs events related to customer updates." "Relational Database" {
            tags "Bank"
        }
    }


    // --- 3. Define all Relationships after all elements are declared ---
    client -> online_banking "1. Uses" "HTTPS"
    client -> mobile_banking "1. Uses" "IOS/Android"

    online_banking -> okta "2. Authenticates User" "OpenID Connect"
    mobile_banking -> okta "2. Authenticates User" "OpenID Connect/OAuth2"

    online_banking -> bank_systems.kyc_ui "3. Launches (from dashboard banner or as Interstitial page)" "Web Component"
    mobile_banking -> bank_systems.kyc_ui "3. Launches (from dashboard banner or as Interstitial page)" "Web Component/Webview"

    bank_systems.kyc_ui -> bank_systems.customer_profile_service "4. Fetches/Updates Customer Data (Demographics, Contact, Employment)" "HTTPS/REST API via Bank API Gateway"
    
    bank_systems.customer_profile_service -> bank_systems.bank_api_gateway "4a. Sends/Validates OTP" "API Call"
    bank_systems.bank_api_gateway -> twilio "4b. Sends/Validates OTP via SMS/Voice" "Twilio API"

    bank_systems.customer_profile_service -> codeconnect_gateway "5. Fetches/Updates" "API Calls"
    codeconnect_gateway -> core_banking "5a. Routes to Core Banking" "Internal API Calls"
    bank_systems.customer_profile_service -> bank_systems.dih_database "5b. Logs Update Event" "Internal Database Call"

    bank_systems.customer_profile_service -> bank_systems.bank_api_gateway "6. Syncs Contact Info and Updates MFA Factors" "Okta API"
    bank_systems.bank_api_gateway -> okta "6a. Routes to Okta" "Okta API via Bank API Gateway"

    bank_systems.customer_profile_service -> bank_systems.alerts_service "7. Sends Confirmation" "Internal API Call"
    
}

views {
    systemContext bank_systems customer_verification "System Context Diagram for Customer Profile Verification." {
        include *
        include client
        include twilio
        include core_banking
        include codeconnect_gateway
        autoLayout
    }
    container bank_systems customer_verification_containers "Container Diagram for Customer Profile Verification." {
        include *
        include client
        include twilio
        include core_banking
        include codeconnect_gateway
        autoLayout
    }

    // Styles block moved inside the views block as per user's environment requirement
    styles {
        element "Vendor" {
            background #90EE90
            color #000000
            shape Box
        }
        element "Bank" {
            background #007bff
            color #FFFFFF
            shape Box
        }
        element "Person" {
            shape Person
            color #000080
        }
        element "Software System" {
            background #E0E0E0
            color #000000
            shape Box
        }
        element "Software System Boundary" {
            stroke #FF0000
            strokeWidth 5
            opacity 70
        }
    }
}

}
