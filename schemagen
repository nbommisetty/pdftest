  "accountId": "AC-123-456-7890",
  "accountType": "CHECKING",
  "accountName": "Primary Checking Account",
  "nickname": "Daily Spending",
  "status": "ACTIVE",
  "currency": "USD",
  "availableBalance": 500.50,
  "currentBalance": 525.75,
  "balanceAsOfDate": "2025-09-24",
